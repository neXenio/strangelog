// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`getProjectConfig > when there is a .strangelogrc > returns configuration from .strangelogrc merged over defaults 1`] = `
{
  "components": {
    "comp1": "Comp 1",
    "comp2": "Comp 2",
  },
  "path": "changelog",
}
`;

exports[`getProjectConfig > when there is no .strangelogrc > returns default configuration 1`] = `
{
  "components": {},
  "path": "./changelog",
}
`;
