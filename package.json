{
  "name": "strangelog",
  "version": "2.0.2",
  "description": "Painless file-based changelog management via CLI.",
  "main": "index.js",
  "repository": "git@github.com:neXenio/strangelog.git",
  "author": "neXenio GmbH <contact@nexenio.com>",
  "license": "MIT",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "compile": "babel src/ --out-dir lib/",
    "test-dev": "jest --config=jest.config.json --watch",
    "test-ci": "jest --config=jest.config.json --runInBand",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "flow": "flow check",
    "ci-pipeline": "yarn run test-ci && yarn run lint && yarn run flow",
    "prepare": "yarn run compile",
    "start": "babel-node src/cli/index.js",
    "changelog": "babel-node src/cli/index.js",
    "changelog-generate": "babel-node src/cli/index.js generate --outFile CHANGELOG.md"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.6",
    "@babel/core": "^8.0.6",
    "@babel/node": "^8.0.6",
    "@babel/preset-env": "^8.0.6",
    "@babel/preset-flow": "^8.0.1",
    "@babel/register": "^8.0.6",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "babel-jest": "^30.5.2",
    "eslint": "^10.12.0",
    "eslint-plugin-import-x": "^4.17.1",
    "flow-bin": "^0.334.0",
    "globals": "^17.13.0",
    "hermes-eslint": "^0.37.0",
    "jest": "^30.5.2"
  },
  "dependencies": {
    "fs-extra": "^11.4.1",
    "glob": "^13.0.6",
    "inquirer": "^14.2.3",
    "js-yaml": "^5.4.3",
    "semver": "^7.8.5",
    "yargs": "^18.2.0"
  },
  "bin": {
    "strangelog": "./lib/cli/index.js"
  }
}
