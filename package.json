{
  "name": "strangelog",
  "version": "2.0.2",
  "description": "Painless file-based changelog management via CLI.",
  "main": "index.js",
  "types": "lib/index.d.ts",
  "files": [
    "index.js",
    "lib/",
    "AGENTS.md",
    "CHANGELOG.md"
  ],
  "repository": "git@github.com:neXenio/strangelog.git",
  "author": "neXenio GmbH <contact@nexenio.com>",
  "license": "MIT",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "compile": "tsc -p tsconfig.build.json",
    "test-dev": "vitest",
    "test-ci": "vitest run",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "ci-pipeline": "yarn run test-ci && yarn run lint && yarn run typecheck",
    "prepare": "yarn run compile",
    "start": "tsx src/cli/index.ts",
    "changelog": "tsx src/cli/index.ts",
    "changelog-generate": "tsx src/cli/index.ts generate --outFile CHANGELOG.md"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.20.5",
    "@types/semver": "^7.8.0",
    "@types/yargs": "^17.0.35",
    "eslint": "^10.12.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "fs-extra": "^11.4.1",
    "glob": "^13.0.6",
    "inquirer": "^14.2.3",
    "js-yaml": "^5.4.3",
    "semver": "^7.8.5",
    "yargs": "^18.2.0"
  },
  "bin": {
    "strangelog": "./lib/cli/index.js"
  }
}
